#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {

    srand(time(0));
    int jugador, computadora;

    cout << "1. Piedra" << endl;
    cout << "2. Papel" << endl;
    cout << "3. Tijera" << endl;
    cin >> jugador;

    computadora = rand() % 3 + 1;

    cout << "La computadora eligio: " << computadora << endl;

    if (jugador == computadora) {
        cout << "Empate";
    }
    else if ((jugador == 1 && computadora == 3) ||
             (jugador == 2 && computadora == 1) ||
             (jugador == 3 && computadora == 2)) {
        cout << "Ganaste";
    }
    else {
        cout << "Perdiste";
    }

    return 0;
}
