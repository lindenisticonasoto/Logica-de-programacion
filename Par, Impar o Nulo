#include <iostream>
using namespace std;

int main()
{
    int n;

    cin >> n;

    if (n == 0)
    {
        cout << "Nulo";
    }
    else
    {
        if (n % 2 == 0)
        {
            cout << "Par";
        }
        else
        {
            cout << "Impar";
        }
    }

    return 0;
}
